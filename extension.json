{
	"name": "QuickGV",
	"version": "1.0.0",
	"author": "[https://github.com/virus-warnning Raymond Wu]",
	"url": "https://www.mediawiki.org/wiki/Extension:QuickGV",
	"descriptionmsg": "quickgv-desc",
	"license-name": "MIT",
	"type": "parserhook",
	"requires": {
		"MediaWiki": ">= 1.43"
	},
	"MessagesDirs": {
		"QuickGV": ["i18n"]
	},
	"AutoloadNamespaces": {
